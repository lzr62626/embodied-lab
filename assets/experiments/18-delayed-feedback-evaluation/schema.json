  "outer_inputs": "q_ref[t],same-run actual q_used[t-1],u_ff[t];current qpos diagnostic is appended after command calculation",
  "reference_clock": "t (not delayed)",
  "measurement_clock": "t-1;one20Hz control period0.05s;not one100Hz physics substep",
  "error_used_rad": "q_ref[t]-q_used[t-1],participates in outer correction",
  "error_current_rad": "q_ref[t]-q_current[t],diagnostic only",
  "controller_anchor": "underlying PD target uses current actual qpos[t]+actual command*0.1rad;use_target=false",
  "boundary_flags": {
    "was_clipped": "raw value strictly outside original float32 interface bound",
    "sent_at_bound": "actual float32 sent value equals either bound"
  },
  "legacy_audits": "C0/P0 retain original q_actual/error_rad fields,meaning current measurement;no history or records rewritten",
  "diagnostics": "cube truth,success,controller targets,RGB,qvel are not outer formula inputs",
  "comparison": "shared state indices9..minimum completed actions;all currently9..20 inclusive",
  "tracking_deviation_rad": "q_group[k]-q_U[k] (opposite sign to instantaneous feedback error)",
  "paired_responses": {
    "r0_rad": "P0-C0",
    "r1_rad": "P1-C1",
    "r1_minus_r0_rad": "r1-r0",
    "C1_minus_C0_rad": "delay contrast without intervention",
    "P1_minus_P0_rad": "delay contrast with intervention"
  },
  "scope": "known seeds,fixed one-second runs,known reference and clock,historical baselines reused;no randomized causal or stability claim"
