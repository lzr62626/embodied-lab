  "action_source": "0original prefix,1PE-only override t8,2actual extrapolated outer feedback t>=9",
  "outer_inputs": "known q_ref[t],known u_ff[t],same-run q_latest[t-1],q_previous[t-2];no actual current angle/velocity/RGB/truth/history actions",
  "calculation_order": "float64 delta=latest-previous;estimated=latest+delta;error=q_ref-estimated;correction=error/0.1;raw=u_ff+correction;clip original bound then float32",
  "indices": "action9 uses states7/8 to estimate9;action10 uses8/9 to estimate10;action19 uses17/18 to estimate19",
  "delay": "newest measurement age1control step0.05s;older measurement age2steps0.10s;prediction horizon1step0.05s;not a two-step-delay experiment",
  "current_truth": "read only after outer command is computed;used for audit/metrics,not control",
  "controller_anchor": "bottom PD remains current actual qpos[t]+normalized command*0.1rad,use_target=false",
  "boundary_flags": {
    "was_clipped": "u_raw strictly exceeds original float32 interface bound",
    "sent_at_bound": "actual float32 sent value equals either bound"
  },
  "legacy_audits": "C0/P0 current-q_actual fields and C1/P1 delayed-q_used fields kept unchanged;no estimated audit fabricated for historical controls",
  "estimate_error_rad": "q_estimated[t]-same-run q_current[t]",
  "hold_error_rad": "q_latest[t-1]-same-run q_current[t];not another executed controller",
  "estimation_metric_range": "actual decision indices9..N-1;currently11values9..19",
  "tracking_metric_range": "common state indices9..min actual N;currently12values9..20",
  "tracking_deviation_rad": "q_group[k]-q_U[k]",
