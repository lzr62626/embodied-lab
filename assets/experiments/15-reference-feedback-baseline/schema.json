{
  "version": "reference-feedback-baseline-v1",
  "new_group": "D-reference-feedback",
  "group_mapping": {
    "U": "article13 unperturbed A-script",
    "A": "article14 A-script-continuation",
    "B": "article14 B-H-MLP",
    "C": "article14 C-H-1NN",
    "D": "article15 D-reference-feedback"
  },
  "new_seeds": [
    45,
    46
  ],
  "seeds_previously_used": true,
  "axes": {
    "N": "actual action/transition count,20 each",
    "N+1": "state count,21 each",
    "E": "single environment axis; explicitly index0",
    "M": "actual feedback decisions,N-9=11"
  },
  "raw_qpos": "(N+1,1,9)float32; seven arm angles(rad), two finger positions(m)",
  "raw_qvel": "(N+1,1,9)float32; seven arm velocities(rad/s), two finger velocities(m/s)",
  "raw_RGB": "(N+1,1,256,256,3)uint8,HWC,0..255; originalPNG retained",
  "controller_input": [
    "raw current qpos[t,0,0] in rad",
    "article13 same-seed reference qpos[t,0,0]",
    "article13 reference actions[t,0]"
  ],
  "extra_information": "Known reference trajectory and reference clock; not available to the old H policies",
  "state_normalization": "Not used by D; physical rad divided by fixed0.1rad scale",
  "actions": "(N,8)float32 normalized commands; only first joint varies, arm2..7 zero, gripper1",
  "audit/action_source": {
    "0": "shared script0..7",
    "1": "forced override8",
    "2": "reference feedback9..19"
  },
  "audit/feedback_active": "(N,)bool, true only at t>=9",
  "audit/intervention": "(N,)bool,true only at8",
  "feedback_audit": {
    "t": "(M,)int64 actual action index9..19",
    "reference_state_index": "(M,)int64,t not t+1",
    "actual_state_index": "(M,)int64,t",
    "q_ref": "(M,)float64 rad",
    "q_actual": "(M,)float64 rad copied from actual current observation",
    "error_rad": "q_ref-q_actual,rad,float64",
    "u_ff": "normalized feedforward,float64",
    "correction": "gain*error_rad/0.1rad,float64,dimensionless",
    "u_raw": "u_ff+correction,float64",
    "u_clipped_float64": "float64 result before final dtype cast",
    "u_sent": "(M,)float32 actual sent action0",
    "was_clipped": "strict out-of-interface-bound flag,bool",
    "sent_at_bound": "actual float32 value equals either interface bound,bool",
    "controller_target_qpos": "(M,7)float32 rad, actual arm target read after setting action"
  },
  "nominal_command_limit": 0.1,
  "actual_float32_limit_as_float64": 0.10000000149011612,
  "calculation_precision": "float64 error/correction, then float32 sent command; no parameter fitting",
  "diagnostics": {
    "diagnostic/cube_pose": "state truth:xyz(m),wxyz quaternion; not input",
    "diagnostic/arm_target_qpos": "transition target(rad); not actual next position",
    "diagnostic/gripper_target_qpos": "transition target(m)",
    "info/success": "per-transition task flag,not input"
  },
  "comparison_metrics": "states9..common_end inclusive; signed deviation is q_actual-q_ref, opposite sign to feedback error",
  "time": "Control20Hz=0.05s; physics100Hz; override8 spans0.40..0.45s; feedback9 starts0.45s",
